# Sentinel AI machine-local configuration reference.
# The backend/AI code reads OS environment variables; this file documents names
# and can be copied/adapted by local tooling. Never commit real secrets.

# Backend persistence. Leave unset to use backend/runtime/sentinel.db.
SENTINEL_DATABASE_URL=

# External XD-Violence workspace used by the qualified violence runtime.
# Required only on a machine that runs raw-video violence inference.
SENTINEL_VIOLENCE_ROOT=

# Optional artifact-path overrides. Relative values are resolved under
# SENTINEL_VIOLENCE_ROOT. Leave empty to use the documented workspace layout.
SENTINEL_TEMPORAL_CHECKPOINT=
SENTINEL_TEMPORAL_TRAIN_SCRIPT=
SENTINEL_EXTRACTOR_PYTHON=
SENTINEL_EXTRACTOR_WORKER=
SENTINEL_RUNTIME_WORK_DIR=
